# syntax=docker/dockerfile:1

FROM golang:1.26.4 AS build-stage

WORKDIR /repo/apps/backend

COPY apps/backend/go.mod apps/backend/go.sum ./

RUN go mod download

COPY apps/backend/cmd/ ./cmd/
COPY apps/backend/internal/ ./internal/
COPY apps/backend/migrations/ ./migrations/
COPY contracts/theme/ /repo/contracts/theme/

RUN CGO_ENABLED=0 GOOS=linux go build -o /moodle-shop-image ./cmd/server

FROM  build-stage AS run-test-stage
RUN go test -count=1 -v ./...

FROM gcr.io/distroless/base-debian11 AS build-release-stage

WORKDIR /

COPY --from=run-test-stage /moodle-shop-image /moodle-shop-image

EXPOSE 8080

USER nonroot:nonroot

ENTRYPOINT ["/moodle-shop-image"]
