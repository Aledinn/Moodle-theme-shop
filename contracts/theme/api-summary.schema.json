{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moodle-theme-shop.invalid/contracts/theme/api-summary-v1.schema.json",
  "title": "API theme metadata revision 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "site",
    "author",
    "description",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
        }
      ],
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "site": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}|(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)$",
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "author": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
        }
      ],
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
        }
      ],
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    }
  }
}
