{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moodle-theme-shop.invalid/contracts/theme/portable-v1.schema.json",
  "title": "Portable theme contract revision 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "site",
    "author",
    "description",
    "version",
    "rules"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
        }
      ],
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "site": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}|(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)$",
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "author": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
        }
      ],
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f<>\u202a-\u202e\u2066-\u2069]*$",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"
        }
      ],
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "properties"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:[A-Za-z][A-Za-z0-9-]*(?:[.#](?:[A-Za-z_]|-[A-Za-z_-])[A-Za-z0-9_-]*)*|(?:[.#](?:[A-Za-z_]|-[A-Za-z_-])[A-Za-z0-9_-]*)+)(?: (?:[A-Za-z][A-Za-z0-9-]*(?:[.#](?:[A-Za-z_]|-[A-Za-z_-])[A-Za-z0-9_-]*)*|(?:[.#](?:[A-Za-z_]|-[A-Za-z_-])[A-Za-z0-9_-]*)+))*$",
            "not": {
              "pattern": "[\r\n\u2028\u2029]"
            }
          },
          "properties": {
            "type": "object",
            "minProperties": 0,
            "maxProperties": 3,
            "additionalProperties": false,
            "properties": {
              "background-color": {
                "$ref": "#/definitions/color"
              },
              "color": {
                "$ref": "#/definitions/color"
              },
              "font-family": {
                "type": "string",
                "maxLength": 128,
                "enum": [
                  "Arial, sans-serif",
                  "Verdana, sans-serif",
                  "Georgia, serif",
                  "'Courier New', monospace",
                  "system-ui, sans-serif"
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "not": {
        "pattern": "[\r\n\u2028\u2029]"
      }
    }
  }
}
